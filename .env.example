# ─── Banco de Dados ────────────────────────────────────────────────────────────
# Para desenvolvimento local: DB_DRIVER=sqlite
# Para produção (Railway/MySQL): DB_DRIVER=mysql
DB_DRIVER=sqlite
DB_NAME=/app/database/biblioteca.db

# ─── MySQL (usado apenas quando DB_DRIVER=mysql) ───────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
