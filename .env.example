# ─── Banco de Dados ────────────────────────────────────────────────────────────
# Para desenvolvimento local: DB_DRIVER=sqlite
# Para produção (Railway/MySQL): DB_DRIVER=mysql
DB_DRIVER=sqlite
DB_NAME=/caminho/para/database/biblioteca.db

# ─── MySQL (usado apenas quando DB_DRIVER=mysql) ───────────────────────────────
# No Railway, preencha com as variáveis fornecidas pelo plugin MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=sua_senha_aqui
# DB_NAME=biblioteca
